# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.bridge.*.log
.bridge.pid
.relay*.log
.agent-forest-companion.json
.agent-forest-pairing.json
.devserver.*.log
.devserver.pid

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/tmp/

# Local generation sources and exports are not needed by the deployed site.
/assets/
/output/

# Keep generated character variants locally; the current site uses the Cats Pack.
/public/models/raccoon-*.glb
/public/models/raccoon-*.png
/public/models/raccoon-*.json
/public/models/hybrid-coach-01-rigged.glb

# Keep heavyweight Meshy source exports locally. The deployed site uses only
# the web GLBs and the final shell texture listed outside these patterns.
/public/models/cat-care-v1/*-meshy6-v1.glb
/public/models/cat-care-v1/*-meshy6-v1_base_color.png
/public/models/collectible-shell-v2/*_base_color-soft-seam-v1.png
/public/models/collectible-shell-v2/*_base_color.png

# 서버 키가 박히는 파일 — 절대 커밋하지 않는다
deploy/sidak/pm-worker.asp
